# =============================================================================
# Variáveis do wlstore-fe. Copie para .env.local (gitignored) e ajuste:
#   cp .env.example .env.local
# O Next.js lê os arquivos .env da RAIZ do projeto (não de src/).
#
# Todas são lidas em RUNTIME, no servidor (Server Components/Actions). Por
# isso a mesma imagem serve develop e prod: no cluster, os valores vêm dos
# values do repo de infra (projects/wlstore/apps/wlstore-fe/values*.yaml).
# Não use NEXT_PUBLIC_* para nada que mude por ambiente: ele é gravado no
# bundle no `next build` e quebraria a promoção da imagem para prod.
# =============================================================================

# catalog-service (no cluster: http://catalog-service:8081)
CATALOG_API_URL=http://localhost:8081

# pricing-service (no cluster: http://pricing-service:8082)
PRICING_API_URL=http://localhost:8082

# Tenant fixo enquanto não há login (vazio = tenant de desenvolvimento)
TENANT_ID=
